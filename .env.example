# Copy this file to .env and fill in your real values
# Get these from Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Get this from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API, Distance Matrix API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# Stripe — get from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Supabase service role key — REQUIRED by every protected /api route (they refuse to run without it)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Domain for Stripe redirects
DOMAIN=https://rideupnassau.com
