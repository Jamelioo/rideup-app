# Copy this file to .env and fill in your real values
#
# Demo mode (fake data, no backend) turns on automatically when VITE_SUPABASE_URL is empty,
# or explicitly with VITE_DEMO_MODE=true. Never set it in production.
# VITE_DEMO_MODE=false
# Get these from Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Get this from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API, Directions API
# This key ships in the browser bundle by design: restrict it in Google Cloud to your HTTP referrers
# (https://rideupnassau.com/*) and to only the APIs above, and set a daily quota/budget alert.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# Supabase service role key — REQUIRED by every protected /api route (they refuse to run without it)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Random string protecting /api/dispatch-scheduled (Vercel Cron sends it automatically)
CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Emails: driver approval/rejection, trip receipts, refunds, unpaid-fare notices (optional;
# without a key nothing is emailed and everything else still works)
RESEND_API_KEY=
EMAIL_FROM=RideUp <noreply@rideupnassau.com>

# Cancellation and no-show policy (Uber-style). Every trip is paid in cash, so cancelling never costs anything;
# instead two late cancellations or no-shows in 30 days pause booking (the database counts late after 2 minutes).
# After a driver accepts, how long a rider can cancel without it counting as late, in seconds (keep at 120)
CANCEL_GRACE_SECONDS=120
# Free waiting time at pickup before the driver can cancel as a no-show, in seconds
FREE_WAIT_SECONDS=300
# Copies for the in-app timers; keep them equal to the two values above
VITE_CANCEL_GRACE_SECONDS=120
VITE_FREE_WAIT_SECONDS=300
# RideUp guarantee: credit added when a driver cancels after accepting (cents; 0 turns it off; once per rider per 24h)
DRIVER_CANCEL_CREDIT_CENTS=500

# Web push trip notifications (optional). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rideupnassau.com
VITE_VAPID_PUBLIC_KEY=
